{
  "manifest_version": 3,
  "name": "ClaudeOClock",
  "version": "1.0.0",
  "description": "Sends claude.ai usage data to the ClaudeOClock desk display daemon.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClaudeOClock"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
